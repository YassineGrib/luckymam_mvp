{
  "firestore": {
    "database": "(default)",
    "location": "nam5",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "admin",
      "ignore": ["node_modules", ".git", "firebase-debug.log", "firebase-debug.*.log"],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR/../luckymam_admin\" run build",
        "node \"$RESOURCE_DIR/prepare.mjs\""
      ]
    }
  ],
  "hosting": [
    {
      "target": "admin",
      "public": "luckymam_admin/.output/public",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "headers": [
        {
          "source": "/assets/**",
          "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
        }
      ],
      "rewrites": [
        {
          "source": "**",
          "function": {
            "functionId": "adminSsr",
            "region": "us-central1"
          }
        }
      ]
    }
  ]
}