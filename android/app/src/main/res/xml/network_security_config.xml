<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      Production: HTTPS only. No cleartext. No user-installed CA certs.
      This is required for Google Play Data Safety compliance.
    -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!--
      Development override: allow cleartext on localhost for Flutter dev tools.
      This domain-config applies ONLY in debug builds via manifest merging.
    -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">10.0.3.2</domain>
    </domain-config>
</network-security-config>
