# Firebase Web config for the luckymam-app-dv project.
#
# The Android app already exists in this Firebase project, but a *Web app*
# has not been registered yet. To get these values:
#   1. Firebase Console → luckymam-app-dv → Project settings → General
#   2. Under "Your apps", click "Add app" → Web (</>) icon
#   3. Register it (e.g. name "Luckymam Admin") — no Hosting setup needed yet
#   4. Copy the firebaseConfig values below
#
# Copy this file to .env.local and fill in the real values. .env.local is
# gitignored — never commit real credentials.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=luckymam-app-dv.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=luckymam-app-dv
VITE_FIREBASE_STORAGE_BUCKET=luckymam-app-dv.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=834179717761
VITE_FIREBASE_APP_ID=
